rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ============================================================================
    // HELPER FUNCTIONS
    // ============================================================================

    // Checks if the client has a valid authenticated Firebase Auth session
    function isAuthenticated() {
      return request.auth != null;
    }

    // Checks if a corresponding user document exists in the users collection
    function hasUserDoc() {
      return isAuthenticated() &&
        exists(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    // Retrieves the current authenticated user's profile document data
    function getUserDoc() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    // Checks if the user is approved by an administrator
    function isApproved() {
      return hasUserDoc() &&
        getUserDoc().status.lower() == 'approved';
    }

    // Checks if the user has an admin or super_admin role
    function isAdmin() {
      return isApproved() &&
        (getUserDoc().role == 'admin' || getUserDoc().role == 'super_admin');
    }

    // Checks if the user is a super_admin
    function isSuperAdmin() {
      return isApproved() &&
        getUserDoc().role == 'super_admin';
    }

    // ============================================================================
    // 1. USERS COLLECTION
    // ============================================================================
    match /users/{userId} {
      // Authenticated users can read member directory & profile info
      allow read: if isAuthenticated();

      // Invitation-Only: Only Admins can provision user accounts.
      // Self-registration is disabled at the database level.
      allow create: if isAdmin();

      // Updates:
      // - Admins can update roles, status approvals, or user details
      // - Regular users can update their own profile name, but CANNOT self-promote
      //   role or status (prevent privilege escalation)
      allow update: if (isAdmin()) || (
        isAuthenticated() &&
        request.auth.uid == userId &&
        request.resource.data.role == resource.data.role &&
        request.resource.data.status == resource.data.status
      );

      // Only Super Admins can permanently delete user records
      allow delete: if isSuperAdmin();
    }

    // ============================================================================
    // 2. EVENTS COLLECTION & ALL SUBCOLLECTIONS (RECURSIVE)
    // ============================================================================
    // Matches events root documents
    match /events/{eventId} {
      allow read: if isApproved();
      allow write: if isAdmin();
    }

    // Matches all nested subcollections under events:
    // - attendance_sessions (and students)
    // - items (participants, categories, idCards)
    // - teachers
    // - teams
    // - sponsorship_records
    // - yf_colleges, yf_accommodation_allotments, yf_facilities, yf_venues, yf_tags
    match /events/{eventId}/{allChildren=**} {
      allow read: if isApproved();
      allow write: if isAdmin();
    }

    // ============================================================================
    // 3. GLOBAL CORE TEAM COLLECTION
    // ============================================================================
    match /global_core_team/{memberId} {
      allow read: if isApproved();
      allow write: if isAdmin();
    }

    // ============================================================================
    // 4. SYSTEM ACTIVITY LOGS (APPEND-ONLY AUDIT TRAIL)
    // ============================================================================
    match /logs/{logId} {
      // Only admins can inspect audit logs
      allow read: if isAdmin();

      // Any authenticated user can log actions, but cannot forge identity
      allow create: if isAuthenticated() &&
                    request.resource.data.email == request.auth.token.email;

      // Tamper-proof: Absolutely no modifications or deletions permitted
      allow update, delete: if false;
    }

    // ============================================================================
    // 5. SENT BROADCAST EMAILS COLLECTION
    // ============================================================================
    match /sent_emails/{emailId} {
      // Broadcast history is strictly restricted to Administrators
      allow read: if isAdmin();
      allow create: if isAdmin();
      allow update, delete: if isSuperAdmin();
    }
  }
}
